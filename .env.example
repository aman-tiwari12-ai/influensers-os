# Influencer OS — Environment Variables
# Copy this file to .env and fill in your keys

# YouTube Data API v3
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Meta Graph API (Instagram)
# Get from: https://developers.facebook.com → My Apps → Graph API Explorer
INSTAGRAM_ACCESS_TOKEN=your_meta_graph_api_long_lived_token
IG_BUSINESS_USER_ID=your_instagram_business_account_id

# Anthropic (Claude Sonnet — content intelligence + outreach generation)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# Brevo (email delivery — 300 free emails/day)
# Get from: https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=your_brevo_api_key
SENDER_EMAIL=outreach@yourbrand.com
SENDER_NAME=Your Brand Name

# Instagram DM automation (Instagrapi)
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
